    advanceType: 1
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 2
    id: base_Factory_intro
    bodyText: "\uBB34\uAE30 '\uD3EC\uD0C4'\uC744 \uC120\uD0DD\uD558\uC138\uC694."
