MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d181c03df4d514477af7af4667bb6e22, type: 3}
  m_Name: TutorialConfig
  m_EditorClassIdentifier: Assembly-CSharp::TutorialConfig
  bodyFont: {fileID: 11400000, guid: a5e325fc73a121645b8bb045804e62a4, type: 2}
  overlayPrefab: {fileID: 4634822672165253103, guid: 7f288b02607aa48329b0d17e2740491f, type: 3}
  steps:
  - order: 1
    id: open_player
    bodyText: "'\uB808\uB4DC\uBE0C\uB9AC\uCC98'\uC5D0 \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4.\n\uC2DC\uC791\uD558\uAE30
      \uC55E\uC11C \uBB34\uAE30/\uB4DC\uB860\uC744 \uAD50\uCCB4\uD558\uB294 \uBC29\uBC95\uC744
      \uC54C\uB824\uB4DC\uB9AC\uACE0\uC790 \uD569\uB2C8\uB2E4.\n\n\uBA3C\uC800 \uAE30\uCCB4
      \uD0ED\uC744 \uD130\uCE58\uD558\uC138\uC694."
    highlightTargetName: Player_Btn
    advanceType: 1
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 1
    id: open_player
    bodyText: "\uC6B0\uCE21\uC5D0 \uC8FC\uBB34\uC7A5\uC73C\uB85C \uD45C\uC2DC\uB41C
      \uC544\uC774\uCF58\uC744 \uD074\uB9AD\uD558\uC138\uC694."
    highlightTargetName: Weapon_Image_Button
    advanceType: 1
    eventType: 0
    targetAmount: 6
    targetId: 
  - order: 1
    id: open_player
    bodyText: "\uBB34\uAE30 '\uD3EC\uD0C4'\uC744 \uC120\uD0DD\uD558\uC138\uC694."
    highlightTargetName: LoadoutOptionButton(Clone)
    advanceType: 1
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 1
    id: open_player
    bodyText: "\uC120\uD0DD \uC2DC '\uC7A5\uCC29\uD558\uAE30' \uBC84\uD2BC\uAE4C\uC9C0
      \uB20C\uB7EC\uC57C \uC815\uC0C1\uC801\uC73C\uB85C \uC7A5\uCC29\uB429\uB2C8\uB2E4."
    highlightTargetName: Equip_Button
    advanceType: 1
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 1
    id: open_player
    bodyText: "\uC798\uD558\uC168\uC2B5\uB2C8\uB2E4! \uC774\uC81C \uAE30\uCC44 \uD0ED\uC5D0
      \uB300\uD574\uC11C \uC18C\uAC1C\uD558\uACA0\uC2B5\uB2C8\uB2E4.\n\n\uC7A5\uCC29\uD55C
      \uBB34\uAE30/\uB4DC\uB860 \uC2A4\uD15F\uC740 \uC544\uB798\uC758 \uD328\uB110\uC5D0
      \uD45C\uC2DC\uD569\uB2C8\uB2E4. "
    highlightTargetName: Weapon/Drone Infos_BG_Frame
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 1
    id: open_player
    bodyText: "\uADF8 \uC704\uC5D0 \uBC84\uD2BC\uC744 \uD1B5\uD574\uC11C \uBB34\uAE30/\uB4DC\uB860
      \uC2A4\uD15F \uC815\uBCF4\uB97C \uC11C\uB85C \uBC88\uAC08\uC544 \uBCFC \uC218
      \uC788\uC2B5\uB2C8\uB2E4. "
    highlightTargetName: InfoButtons Group
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 1
    id: open_player
    bodyText: "\uC704\uC5D0 \uD328\uB110\uC740 \uD50C\uB808\uC774\uC5B4\uAC00 \uD0D1\uC2B9
      \uC911\uC778\n\uD0F1\uD06C \uC2A4\uD0EF\uC744 \uD45C\uC2DC\uD558\uB294 \uAD6C\uAC04\uC785\uB2C8\uB2E4.\n\n\uB2A5\uB825\uCE58
      \uBC0F \uD604\uC7AC \uD0F1\uD06C\uB808\uBCA8\uC744 \uD655\uC778 \uD560 \uC218
      \uC788\uC2B5\uB2C8\uB2E4."
    highlightTargetName: Player nfos_BG_Frame
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 1
    id: open_player
    bodyText: "\uC544\uB798\uC758 \uD654\uC0B4\uD45C \uBC84\uD2BC\uC744 \uD1B5\uD574
      \uBCF4\uB2E4 \uB354 \uC0C1\uC138\uD55C \uC815\uBCF4\uB97C \uC0B4\uD3B4 \uBCFC
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    highlightTargetName: RouteDetailButton
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 1
    id: open_player
    bodyText: "\uB4DC\uB860 \uC785\uB2C8\uB2E4. \uC774 \uBCD1\uAE30\uB294 \uD0F1\uD06C\uB97C
      \uC5C4\uD638\uD558\uAE30 \uC704\uD574 \uB9CC\uB4E4\uC5B4\uC84C\uC73C\uBA70
      \uBCF4\uC870\uC801\uC73C\uB85C \uD654\uB825\uC9C0\uC6D0\uC744 \uD22C\uC0AC\uD569\uB2C8\uB2E4.\n\n\uB4DC\uB860
      \uC544\uC774\uCF58\uC744 \uB20C\uB7EC \uC0B4\uD3B4\uBCF4\uC138\uC694. "
    highlightTargetName: Drone_Image_Button
    advanceType: 1
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 1
    id: open_player
    bodyText: "\uB4DC\uB860 \uC778\uBCA4\uD1A0\uB9AC\uC785\uB2C8\uB2E4.\n\n\uC9C0\uAE08\uC740
      \uB4DC\uB860 1\uAE30 \uBC16\uC5D0 \uC5C6\uC9C0\uB9CC\n\uCD94\uD6C4 \uBB34\uAE30\uCC98\uB7FC
      \uB2E4\uC591\uD55C \uC885\uB958\uAC00 \uC0DD\uAE38 \uB54C\n\uAC19\uC740 \uBC29\uC2DD\uC73C\uB85C
      \uAD50\uCC44\uAC00\uB2A5\uD569\uB2C8\uB2E4. "
    highlightTargetName: Viewport
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 1
    id: open_player
    bodyText: "\uC774\uC81C \uB3CC\uC544\uAC00\uAE30 \uBC84\uD2BC\uC744 \uB20C\uB7EC\uC8FC\uC138\uC694."
    highlightTargetName: ExitButton
    advanceType: 1
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 1
    id: open_player
    bodyText: "\uC774\uAC83\uC73C\uB85C \uAE30\uCCB4 \uD0ED\uC5D0 \uB300\uD55C \uC124\uBA85\uC744
      \uB9C8\uCE69\uB2C8\uB2E4.\n\n\uB2E4\uC74C\uC73C\uB85C \uC778\uAC8C\uC784 UI\uC5D0
      \uB300\uD574 \uC18C\uAC1C\uB97C \uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4. "
    highlightTargetName: 
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 1
    id: open_player
    bodyText: "\uAE30\uCCB4 \uD0ED\uC744 \uB098\uAC00\uC2DC\uB824\uBA74 \uB3CC\uC544\uAC00\uAE30
      \uBC84\uD2BC\uC744\n \uB20C\uB7EC\uC8FC\uC138\uC694."
    highlightTargetName: ExitButton
    advanceType: 1
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 1
    id: open_player
    bodyText: "\uD0F1\uD06C\uC758 \uB808\uBCA8\uACFC \uB0B4\uAD6C\uB3C4(HP)\uB97C
      \uD45C\uC2DC\uD558\uB294\n\uC0C1\uD0DC\uCC3D\uC785\uB2C8\uB2E4.\n\n\uB0B4\uAD6C\uB3C4\uAC00
      0\uC774 \uB418\uBA74 \uC804\uCC28\uAC00 \uD30C\uAD34\uB418\uC5B4\n 3\uCD08
      \uD6C4\uC5D0 \uC790\uB3D9\uC73C\uB85C \uC7AC\uBC30\uCE58\uD569\uB2C8\uB2E4. "
    highlightTargetName: UserStatus_Panel
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 1
    id: open_player
    bodyText: "\uD50C\uB808\uC774\uC5B4\uC758 \uC131\uC7A5\uC744 \uB3C4\uC6B8 \uAC00\uC774\uB4DC
      \uC784\uBB34\uC785\uB2C8\uB2E4.\n\n\uC694\uAD6C\uB41C \uC0AC\uD56D \uB2EC\uC131
      \uC2DC \uC7AC\uD654\uBCF4\uC0C1\uC73C\uB85C \uC9C0\uAE09\uB429\uB2C8\uB2E4."
    highlightTargetName: GuideMissionBar
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 1
    id: open_player
    bodyText: "\uD754\uD558\uACE0 \uC4F0\uC774\uB294 \uD654\uD3D0 \uD06C\uB808\uB527\uC785\uB2C8\uB2E4.\n\uAE30\uC9C0\uC2DC\uC124,
      \uD0F1\uD06C \uB4F1 \uC5C5\uADF8\uB808\uC774\uB4DC \uD558\uB294 \uB370 \uC0AC\uC6A9\uD569\uB2C8\uB2E4."
    highlightTargetName: Credit
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 1
    id: open_player
    bodyText: "\uD76C\uADC0\uD55C \uC790\uC6D0\uC778 \uD06C\uB9AC\uC2A4\uD0C8 \uCF54\uC5B4\uC785\uB2C8\uB2E4.\n\uC0C1\uC810\uC744
      \uD1B5\uD574\uC11C \uBB34\uAE30, \uC2A4\uD0AC\uC744 \uBF51\uC744 \uB54C \uC0AC\uC6A9\uD569\uB2C8\uB2E4.\n\n\uBCF4\uC2A4\uCC98\uCE58
      \uBC0F \uB3C4\uC804\uACFC\uC81C \uC644\uB8CC \uC2DC \uD68D\uB4DD\uAC00\uB2A5\uD569\uB2C8\uB2E4."
    highlightTargetName: Core Crystal
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 1
    id: open_player
    bodyText: "\uC2A4\uD0AC \uD45C\uC2DC\uCC3D\uC785\uB2C8\uB2E4.\n\n\uC2A4\uD0AC\uC744
      \uC18C\uC9C0 \uC2DC \uD558\uB2E8\uC5D0 \uC544\uC774\uCF58 \uD45C\uC2DC\uB418\uBA70\n
      \uCD5C\uB300 4\uAC1C\uAE4C\uC9C0 \uC0AC\uC6A9\uAC00\uB2A5\uD569\uB2C8\uB2E4.\n\n\uCFE8\uD0C0\uC784
      \uD0C0\uC774\uBA38\uB85C \uC791\uB3D9\uD558\uBA70 \n0\uC774 \uB418\uBA74 \uBC14\uB85C
      \uC2A4\uD0AC\uC774 \uBC1C\uB3D9\uB429\uB2C8\uB2E4."
    highlightTargetName: Skill Cooldown
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 1
    id: open_player
    bodyText: "\uC2A4\uD14C\uC774\uC9C0\uB97C \uD45C\uC2DC\uD558\uB294 \uCC3D\uC785\uB2C8\uB2E4.\n\n\uB2E8\uC77C
      \uC2A4\uD14C\uC774\uC9C0\uC5D0 \uC5EC\uB7EC \uB77C\uC6B4\uB4DC\uB97C \uAC70\uCE58\uB294
      \uBC29\uC2DD\uC774\uBA70,\n\uBAA8\uB4E0 \uB77C\uC6B4\uB4DC\uAC00 \uC644\uB8CC
      \uC2DC \uC2A4\uD14C\uC774\uC9C0\uAC00 \uC62C\uB77C\uAC11\uB2C8\uB2E4.\n\n\uC2A4\uD14C\uC774\uC9C0\uAC00
      \uC624\uB97C \uC218\uB85D \uBCF4\uC0C1\uACFC \uB9AC\uC2A4\uD06C\uAC00 \uB354\uC6B1
      \uCEE4\uC9D1\uB2C8\uB2E4."
    highlightTargetName: Stage_Panel
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 1
    id: open_player
    bodyText: "\uBCF4\uC2A4\uB97C \uC18C\uD658\uD560 \uC218 \uC788\uB294 \uBC84\uD2BC\uC785\uB2C8\uB2E4.\n\n\uBC84\uD2BC
      \uD074\uB9AD \uC2DC \uD2F0\uCF13\uC774 \uC18C\uBAA8\uB418\uBA70\n\uC801\uC740
      \uBAA8\uB450 \uC0AC\uB77C\uC9C0\uACE0 \n\uBCF4\uC2A4\uC640 1:1\uB85C \uC0C1\uB300\uD569\uB2C8\uB2E4."
    highlightTargetName: Boss Btn
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 1
    id: open_player
    bodyText: "\uC774\uAC83\uC73C\uB85C \uC778\uAC8C\uC784 UI\uC5D0 \uB300\uD55C
      \uC18C\uAC1C\uB97C\n \uB9C8\uCE58\uACA0\uC2B5\uB2C8\uB2E4.\n\n\uC774\uC81C
      \uB098\uB9CC\uC758 \uD0F1\uD06C\uB97C \uC131\uC7A5\uD558\uC5EC\n \uC804\uC7A5\uC744
      \uB3CC\uD30C\uD558\uC138\uC694!"
    highlightTargetName: 
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 2
    id: base_popup_intro
    bodyText: "\uAE30\uC9C0\uC5D0 \uC624\uC2E0 \uAC78 \uD658\uC601\uD569\uB2C8\uB2E4.
      \n\uC774\uACF3\uC5D0\uC11C\uB294 \uC790\uC6D0\uC744 \uC218\uC9D1\uD558\uACE0
      \uC2DC\uC124\uC744 \uC5C5\uADF8\uB808\uC774\uB4DC\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    highlightTargetName: 
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 2
    id: base_popup_intro
    bodyText: "\uBA3C\uC800 \uBCF8\uBD80\uBD80\uD130 \uC548\uB0B4\uD574\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4.\n\n\uC0AC\uB839\uBD80\uB97C
      \uB204\uB974\uC2ED\uC2DC\uC624. "
    highlightTargetName: Command Center
    advanceType: 1
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 2
    id: base_command_center_intro
    bodyText: "\uC0AC\uB839\uBD80\uB294 \uBAA8\uB4E0 \uAE30\uC9C0\uB97C \uD55C \uB208\uC5D0
      \uD30C\uC545\uD560 \uC218 \uC788\uB294 \uD575\uC2EC \uC2DC\uC124\uC785\uB2C8\uB2E4.\n\uC0AC\uB839\uBD80
      \uB808\uBCA8\uC774 \uC624\uB974\uBA74 \uC0C8\uB85C\uC6B4 \uC2DC\uC124\uC774
      \uD574\uAE08\uB429\uB2C8\uB2E4."
    highlightTargetName: Panel
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 2
    id: base_command_center_intro
    bodyText: "\uC9C0\uAE08\uC73C\uB85C\uC36C \uC77C\uBD80 \uAE30\uC9C0\uAC00 \uC7A0\uAE08\uB41C
      \uC0C1\uD0DC\uC785\uB2C8\uB2E4.\n\uAE30\uC9C0\uB97C \uD574\uAE08\uD558\uB824\uBA74
      \uC5C5\uADF8\uB808\uC774\uB4DC \uBC84\uD2BC\uC744 \uB204\uB974\uC138\uC694."
    highlightTargetName: Upgrade_Button
    advanceType: 1
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 2
    id: base_command_center_intro
    bodyText: "\uC774\uC81C \uB3CC\uC544\uAC00\uAE30 \uBC84\uD2BC\uC744 \uB20C\uB7EC\uC8FC\uC138\uC694."
    highlightTargetName: ExitButton_Cmd
    advanceType: 1
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 2
    id: base_refinery_intro
    bodyText: "\uC815\uC81C\uC18C\uC785\uB2C8\uB2E4.\n\uC2DC\uAC04\uC774 \uC9C0\uB0A0\uC218\uB85D
      \uD06C\uB808\uB527\uC774 \uC800\uC7A5\uB429\uB2C8\uB2E4."
    highlightTargetName: Credit Refinery
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 2
    id: base_refinery_intro
    bodyText: "\uAC00\uB4DD \uCC28\uAE30 \uC804\uC5D0 \uC218\uC9D1\uD574 \uC8FC\uC138\uC694."
    highlightTargetName: Collection_Button
    advanceType: 1
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 2
    id: base_refinery_intro
    bodyText: "\uC88B\uC2B5\uB2C8\uB2E4. \uC774\uC81C \uC815\uC81C\uC18C\uC5D0 \uB300\uD574
      \uC790\uC138\uD788 \uB4E4\uC5B4\uB2E4 \uBCF4\uACA0\uC2B5\uB2C8\uB2E4.\n\n\uC815\uC81C\uC18C\uB97C
      \uB204\uB974\uC2ED\uC2DC\uC624."
    highlightTargetName: Credit Refinery
    advanceType: 1
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 2
    id: base_refinery_intro
    bodyText: "\uC815\uC81C\uC18C\uB294 \uD06C\uB808\uB527\uC758 \uC6D0\uB8CC\uC778
      \uAD11\uBB3C\uC744 \uCC44\uC9D1\uD558\uACE0 \uC815\uD654\uD558\uB294 \uC2DC\uC124\uC785\uB2C8\uB2E4.\n\n\uC5EC\uAE38
      \uD1B5\uD574\uC11C \uCD5C\uB300\uC6A9\uB7C9 \uAC2F\uC218\uC640 \uC2DC\uAC04
      \uB2F9 \uC218\uC9D1\uB7C9\uC744 \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    highlightTargetName: Panel
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 2
    id: base_refinery_intro
    bodyText: "\uC5C5\uADF8\uB808\uC774\uB4DC\uB97C \uD558\uBA74 \uD560 \uC218\uB85D
      \uB354 \uBE68\uB9AC, \uB354 \uB9CE\uC774 \uD06C\uB808\uB527\uC744 \uC800\uC7A5\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    highlightTargetName: UpgradeDetail
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 2
    id: base_refinery_intro
    bodyText: "\uBB3C\uB860 \uC5EC\uAE30\uC5D0\uB3C4 \uC218\uC9D1\uAC00\uB2A5\uD569\uB2C8\uB2E4.\n\uAC00\uB4DD\uCC28\uAE30
      \uC804\uC5D0 \uC218\uC9D1\uBC84\uD2BC\uC744 \uB20C\uB7EC\uC8FC\uC138\uC694."
    highlightTargetName: Refinery Storage_Bar_CollectButton
    advanceType: 1
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 2
    id: base_refinery_intro
    bodyText: "\uC774\uC81C \uC2A4\uD15F \uAC15\uD654\uC18C\uB97C \uB458\uB7EC\uBCFC
      \uCC28\uB840\uC785\uB2C8\uB2E4.\n\uB3CC\uC544\uAC00\uAE30 \uBC84\uD2BC\uC744
      \uB20C\uB7EC\uC8FC\uC138\uC694."
    highlightTargetName: ExitButton
    advanceType: 1
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 2
    id: base_TraitPoint_intro
    bodyText: "\uC2A4\uD15F \uAC15\uD654\uC18C\uB97C \uB204\uB974\uC2ED\uC2DC\uC624."
