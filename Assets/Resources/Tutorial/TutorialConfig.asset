    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 2
    id: base_Factory_intro
    bodyText: "\uAC15\uD654\uD560 \uBB34\uAE30\uB97C \uC120\uD0DD\uD558\uC138\uC694."
