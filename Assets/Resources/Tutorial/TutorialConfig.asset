    targetAmount: 0
    targetId: 
  - order: 2
    id: base_outtro
    bodyText: "'\uAD00\uC81C\uC18C'\uC785\uB2C8\uB2E4.\n\uC5EC\uAE30\uC11C\uB294
      \uBCF4\uC2A4 \uD2F0\uCF13 \uC218\uAE09 \uC0C1\uD0DC, \uBCF4\uC2A4\uC5D0 \uB300\uD55C
