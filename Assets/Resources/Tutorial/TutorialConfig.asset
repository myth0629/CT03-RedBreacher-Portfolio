    targetAmount: 0
    targetId: 
  - order: 2
    id: base_TraitPoint_intro
    bodyText: "\uC2A4\uD15F\uAC15\uD654\uC5D0 \uC0AC\uC6A9\uD560 \uD3EC\uC778\uD2B8\uC785\uB2C8\uB2E4.\n\uD50C\uB808\uC774\uC5B4
      \uB808\uBCA8 \uC5C5 \uB9C8\uB2E4 \uD558\uB098 \uC529 \uC5BB\uC2B5\uB2C8\uB2E4."
    highlightTargetName: point
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 2
    id: base_TraitPoint_intro
    bodyText: "\uD654\uB825 \uAC15\uD654 \uBC84\uD2BC\uC744 \uB20C\uB7EC\uC8FC\uC138\uC694."
    highlightTargetName: Att_btn
    advanceType: 1
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 2
    id: base_TraitPoint_intro
    bodyText: "\uBCF4\uC720\uD55C \uD3EC\uC778\uD2B8\uB85C 4\uAC00\uC9C0 \uC911 \uD558\uB098\uB97C
      \uC120\uD0DD\uD574\n\uB2A5\uB825\uCE58\uB97C \uC601\uAD6C\uC801\uC73C\uB85C
      \uC18C\uD3ED \uC0C1\uC2B9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    highlightTargetName: Stat Upgrade
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 2
    id: base_TraitPoint_intro
    bodyText: "\uC774 \uBC11\uC740 \uD50C\uB808\uC774\uC5B4\uAC00 \uD0D1\uC2B9\uD55C
      \uD0F1\uD06C\uC758 \uB2A5\uB825\uCE58\uB97C \uD45C\uC2DC\uD558\uB294 \uAD6C\uAC04\uC785\uB2C8\uB2E4.\n\uC2A4\uD0EF
      \uD3EC\uC778\uD2B8\uB85C \uAC15\uD654 \uC2DC \uC5BC\uB9CC\uD07C \uC0C1\uC2B9\uD588\uB294\uC9C0
      \uC2E4\uC2DC\uAC04\uC73C\uB85C \uD655\uC778\uAC00\uB2A5\uD569\uB2C8\uB2E4."
    highlightTargetName: Tank Status
    advanceType: 0
    eventType: 0
    targetAmount: 0
    targetId: 
  - order: 2
    id: base_TraitPoint_intro
    bodyText: "\uB3CC\uC544\uAC00\uAE30 \uBC84\uD2BC\uC744 \uB20C\uB7EC\uC8FC\uC2ED\uC2DC\uC624."
